{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/fpointerdev/codey-cms/main/docs/schemas/codey-content-bundle-1.0.schema.json",
  "title": "CodeY CMS content bundle 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "collections"],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "kind": {
      "const": "codey-cms.content-bundle"
    },
    "collections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model", "entries"],
        "properties": {
          "model": {
            "$ref": "codey-extension-1.0.schema.json#/$defs/contentModel"
          },
          "entries": {
            "type": "array",
            "maxItems": 5000,
            "items": {
              "$ref": "#/$defs/entry"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "locale", "data", "status"],
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "locale": {
          "type": "string",
          "minLength": 2,
          "maxLength": 16
        },
        "data": {
          "type": "object"
        },
        "status": {
          "enum": ["DRAFT", "PUBLISHED", "ARCHIVED"]
        },
        "publishedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    }
  }
}
