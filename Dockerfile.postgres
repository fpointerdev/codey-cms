FROM postgres:16-alpine@sha256:f2f98726820d0342055351c6e9d36e705f5bfffb3dd53ff556325114b08afb6d

# Keep the official entrypoint and data format, with a smaller privilege helper.
RUN apk add --no-cache libxml2=2.13.9-r3 su-exec=0.3-r0 \
  && rm /usr/local/bin/gosu /usr/local/bin/su-exec \
  && sed -i 's/exec gosu postgres/exec su-exec postgres/' /usr/local/bin/docker-entrypoint.sh \
  && ! grep -q gosu /usr/local/bin/docker-entrypoint.sh \
  && su-exec postgres true
