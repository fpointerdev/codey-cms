{
  "name": "codey-cms",
  "version": "1.3.1",
  "author": "CodeY CMS contributors",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpointerdev/codey-cms.git"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "pnpm prisma:generate && pnpm web:build && tsc -p tsconfig.build.json",
    "web:build": "node scripts/build-premium-visual-runtime.mjs",
    "start": "node dist/src/server.js",
    "test": "node --import tsx --test test/*.test.ts",
    "test:coverage": "node scripts/run-test-coverage.mjs",
    "test:coverage:update": "node scripts/run-test-coverage.mjs --update",
    "test:installation": "node scripts/run-installation-integration-tests.mjs",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:recovery": "node scripts/run-recovery-integration-tests.mjs",
    "test:e2e": "node scripts/run-e2e-tests.mjs",
    "audit:public": "node scripts/audit-public-site.mjs",
    "audit:lighthouse": "node scripts/run-lighthouse-audits.mjs",
    "audit:load": "node scripts/audit-load.mjs",
    "audit:quality": "node scripts/run-public-quality-audits.mjs",
    "test:release": "pnpm run validate && pnpm run test:installation && pnpm run test:integration && pnpm run test:recovery && pnpm run test:e2e",
    "validate": "pnpm run release:containers && pnpm run lint && pnpm run extension:catalog -- --check && pnpm run extension:validate && pnpm run api:check && pnpm run typecheck && pnpm run test:coverage && pnpm run db:validate && pnpm run build",
    "runtime:start": "pnpm db:deploy && node dist/src/server.js",
    "runtime:bootstrap": "pnpm db:deploy && pnpm db:seed",
    "setup:admin": "pnpm prisma:generate && node scripts/setup-admin.mjs",
    "runtime:backup": "node scripts/backup-runtime.mjs",
    "runtime:backup:scheduler": "node scripts/backup-scheduler.mjs",
    "runtime:restore": "node scripts/restore-runtime.mjs",
    "inventory:reconcile": "tsx scripts/inventory-reconcile.ts",
    "release:preflight": "pnpm run release:containers && node scripts/release-preflight.mjs",
    "release:containers": "node scripts/validate-container-pins.mjs",
    "release:launchers": "node scripts/validate-platform-launcher.mjs",
    "release:build": "pnpm run build && node scripts/build-release.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "release:qualify": "node scripts/qualify-selfhost-package.mjs",
    "release:qualify-upgrade": "node scripts/qualify-runtime-upgrade.mjs",
    "lint": "eslint apps/web/web scripts src test",
    "typecheck": "pnpm prisma:generate && tsc --noEmit",
    "audit": "pnpm audit --prod --audit-level high",
    "api:generate": "node scripts/generate-openapi.mjs",
    "api:check": "node scripts/generate-openapi.mjs --check",
    "db:schema": "node scripts/build-prisma-schema.mjs",
    "db:validate": "node scripts/validate-migrations.mjs",
    "prisma:generate": "pnpm db:schema && prisma generate --schema prisma/generated/schema.prisma",
    "db:push": "pnpm db:schema && node scripts/prepare-db-push.mjs && prisma db push --schema prisma/generated/schema.prisma",
    "db:migrate": "pnpm db:schema && prisma migrate dev --schema prisma/generated/schema.prisma",
    "db:deploy": "pnpm db:schema && prisma migrate deploy --schema prisma/generated/schema.prisma",
    "db:seed": "pnpm prisma:generate && tsx prisma/seed.ts",
    "extension:create": "node scripts/create-extension.mjs",
    "extension:catalog": "node --import tsx scripts/generate-extension-catalog.ts",
    "extension:validate": "node --import tsx scripts/validate-extensions.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jose": "^5.10.0",
    "nodemailer": "9.0.6",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "prisma": "^6.19.3",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "6.4.24",
    "@types/sanitize-html": "^2.16.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "motion": "^13.1.1",
    "three": "^0.185.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  },
  "description": "Reusable CodeY CMS runtime for generated websites."
}
