{
  "name": "codey-cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "pnpm prisma:generate && tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "test": "node --import tsx --test test/*.test.ts",
    "validate": "pnpm run typecheck && pnpm run test && pnpm run db:validate && pnpm run build",
    "runtime:start": "pnpm db:deploy && node dist/src/server.js",
    "runtime:bootstrap": "pnpm db:deploy && pnpm db:seed",
    "setup:admin": "pnpm prisma:generate && node scripts/setup-admin.mjs",
    "runtime:backup": "node scripts/backup-runtime.mjs",
    "runtime:restore": "node scripts/restore-runtime.mjs",
    "typecheck": "pnpm prisma:generate && tsc --noEmit",
    "audit": "pnpm audit --prod --audit-level high",
    "db:schema": "node scripts/build-prisma-schema.mjs",
    "db:validate": "node scripts/validate-migrations.mjs",
    "prisma:generate": "pnpm db:schema && prisma generate --schema prisma/generated/schema.prisma",
    "db:push": "pnpm db:schema && prisma db push --schema prisma/generated/schema.prisma",
    "db:migrate": "pnpm db:schema && prisma migrate dev --schema prisma/generated/schema.prisma",
    "db:deploy": "pnpm db:schema && prisma migrate deploy --schema prisma/generated/schema.prisma",
    "db:seed": "pnpm prisma:generate && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jose": "^5.10.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prisma": "^6.8.2",
    "sharp": "^0.35.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "description": "Reusable CodeY CMS runtime for generated websites."
}
