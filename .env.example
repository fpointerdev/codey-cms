NODE_ENV=development
APP_ENV=development
SELF_HOSTED=false
CODEY_ALLOW_LOCAL_SETUP_HTTP=false
APP_NAME=CodeY CMS
APP_MODE=cms
APP_PUBLIC_URL=http://localhost:4000
API_PREFIX=/api/v1
PORT=4000

POSTGRES_DB=codey_site
POSTGRES_USER=codey
POSTGRES_PASSWORD=codey
DATABASE_URL=postgresql://codey:codey@localhost:5432/codey_site?schema=public

JWT_ACCESS_SECRET=dev-only-replace-this-access-secret-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ORIGINS=http://localhost:4000
LOG_LEVEL=info

AUTH_ALLOW_REGISTRATION=false
AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_RECOVERY_TOKEN_DELIVERY=response

CODEY_ADMIN_EMAIL=
CODEY_ADMIN_NAME=Owner
CODEY_ADMIN_PASSWORD=

# Optional deployment fallback. Site owners can manage and test email under Settings > Email.
EMAIL_DRIVER=disabled
EMAIL_FROM=orders@example.com
EMAIL_HTTP_ENDPOINT=
EMAIL_HTTP_BEARER_TOKEN=
EMAIL_TIMEOUT_MS=10000

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage/uploads
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=auto
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_BASE_URL=
STORAGE_KEY_PREFIX=sites/codey-cms
STORAGE_SIGNED_URL_TTL_SECONDS=900
STORAGE_MAX_UPLOAD_BYTES=10485760
STORAGE_UPLOAD_BODY_LIMIT=12mb
STORAGE_IMAGE_VARIANT_WIDTHS=320,640,1200
STORAGE_QUOTA_DEFAULT_MB=512
STORAGE_QUOTA_PRESENTATION_MB=512
STORAGE_QUOTA_CMS_MB=2048
STORAGE_QUOTA_SHOP_MB=5120
STORAGE_QUOTA_SAAS_MB=2048

# Platform secret used only to encrypt credentials saved through the CMS dashboard.
CMS_CREDENTIAL_ENCRYPTION_KEY=dev-only-replace-this-credential-key-32
CODEY_INSTALL_TOKEN=dev-only-replace-this-install-token-32
CODEY_UPDATES_ENABLED=true
CODEY_AUTO_UPDATE=false
CODEY_RELEASE_FEED_URL=https://github.com/loki-code-26/codey-cms/releases/latest/download/stable.json
CODEY_RELEASE_PUBLIC_KEY_FILE=runtime-meta/release-public-key.pem
CODEY_UPDATE_DIR=updates
CODEY_UPDATE_CONTROL_FILE=updates/control/pending-update.json
CODEY_UPDATE_CHECK_INTERVAL_HOURS=6

# Production should require encrypted backups and confirm S3 versioning or replication.
BACKUP_DIR=backups
BACKUP_MIRROR_DIR=
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_HOURS=24
BACKUP_MAX_AGE_HOURS=30
BACKUP_REQUIRED=false
BACKUP_ENCRYPTION_KEY=
BACKUP_REQUIRE_ENCRYPTION=false
BACKUP_S3_MEDIA_PROTECTED=false
BACKUP_ALERT_WEBHOOK_URL=
BACKUP_ALERT_WEBHOOK_TOKEN=
