NODE_ENV=development
APP_ENV=development
APP_NAME=CodeY CMS
APP_MODE=cms
APP_PUBLIC_URL=http://localhost:4000
API_PREFIX=/api/v1
PORT=4000

POSTGRES_DB=codey_site
POSTGRES_USER=codey
POSTGRES_PASSWORD=codey
DATABASE_URL=postgresql://codey:codey@localhost:5432/codey_site?schema=public

JWT_ACCESS_SECRET=dev-only-replace-this-access-secret-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ORIGINS=http://localhost:4000
LOG_LEVEL=info

AUTH_ALLOW_REGISTRATION=false
AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_RECOVERY_TOKEN_DELIVERY=response

CODEY_ADMIN_EMAIL=admin@example.com
CODEY_ADMIN_NAME=Owner
CODEY_ADMIN_PASSWORD=ChangeMe123!

EMAIL_DRIVER=disabled
EMAIL_FROM=orders@example.com
EMAIL_HTTP_ENDPOINT=
EMAIL_HTTP_BEARER_TOKEN=
EMAIL_TIMEOUT_MS=10000

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage/uploads
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=auto
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_BASE_URL=
STORAGE_KEY_PREFIX=sites/codey-cms
STORAGE_SIGNED_URL_TTL_SECONDS=900
STORAGE_MAX_UPLOAD_BYTES=10485760
STORAGE_UPLOAD_BODY_LIMIT=12mb
STORAGE_IMAGE_VARIANT_WIDTHS=320,640,1200
STORAGE_QUOTA_DEFAULT_MB=512
STORAGE_QUOTA_PRESENTATION_MB=512
STORAGE_QUOTA_CMS_MB=2048
STORAGE_QUOTA_SHOP_MB=5120
STORAGE_QUOTA_SAAS_MB=2048

PAYMENTS_WEBHOOK_SECRET=
PAYMENT_STRIPE_WEBHOOK_SECRET=
PAYMENT_PAYPAL_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

BACKUP_DIR=backups
