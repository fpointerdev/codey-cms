NODE_ENV=production
APP_ENV=production
SELF_HOSTED=false
CODEY_ALLOW_LOCAL_SETUP_HTTP=false
APP_NAME=CodeY CMS
APP_MODE=cms
APP_PUBLIC_URL=https://example.com
API_PREFIX=/api/v1
PORT=4000

POSTGRES_DB=codey_site
POSTGRES_USER=codey
POSTGRES_PASSWORD=change-this-db-password
DATABASE_URL=postgresql://codey:change-this-db-password@localhost:5432/codey_site?schema=public

JWT_ACCESS_SECRET=change-this-to-a-long-random-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ORIGINS=https://example.com
LOG_LEVEL=info

AUTH_ALLOW_REGISTRATION=false
AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_RECOVERY_TOKEN_DELIVERY=disabled

# Leave blank and run `pnpm setup:admin`, or inject one-time values during the first seed only.
CODEY_ADMIN_EMAIL=
CODEY_ADMIN_NAME=Owner
CODEY_ADMIN_PASSWORD=

# Optional initial fallback. Site owners can manage email under Settings > Email.
EMAIL_DRIVER=disabled
EMAIL_FROM=orders@example.com
EMAIL_HTTP_ENDPOINT=
EMAIL_HTTP_BEARER_TOKEN=
EMAIL_TIMEOUT_MS=10000

STORAGE_DRIVER=s3
STORAGE_LOCAL_DIR=storage/uploads
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=auto
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_BASE_URL=
STORAGE_KEY_PREFIX=sites/codey-cms
STORAGE_SIGNED_URL_TTL_SECONDS=900
STORAGE_MAX_UPLOAD_BYTES=10485760
STORAGE_UPLOAD_BODY_LIMIT=12mb
STORAGE_IMAGE_VARIANT_WIDTHS=320,640,1200
STORAGE_QUOTA_DEFAULT_MB=512
STORAGE_QUOTA_PRESENTATION_MB=512
STORAGE_QUOTA_CMS_MB=2048
STORAGE_QUOTA_SHOP_MB=5120
STORAGE_QUOTA_SAAS_MB=2048

# Platform secret used only to encrypt credentials saved through the CMS dashboard.
CMS_CREDENTIAL_ENCRYPTION_KEY=change-this-to-a-separate-long-random-encryption-key
CODEY_INSTALL_TOKEN=change-this-to-a-one-time-install-claim-token
CODEY_UPDATES_ENABLED=true
CODEY_AUTO_UPDATE=false
CODEY_RELEASE_FEED_URL=https://github.com/fpointerdev/codey-cms/releases/latest/download/stable.json
CODEY_RELEASE_PUBLIC_KEY_FILE=runtime-meta/release-public-key.pem
CODEY_UPDATE_DIR=/app/updates
CODEY_UPDATE_CONTROL_FILE=/app/updates/control/pending-update.json
CODEY_UPDATE_CHECK_INTERVAL_HOURS=6

# Mount both directories outside the application container. The mirror should be off-host.
BACKUP_DIR=/app/backups
BACKUP_MIRROR_DIR=/app/backups-mirror
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_HOURS=24
BACKUP_MAX_AGE_HOURS=30
BACKUP_REQUIRED=true
BACKUP_ENCRYPTION_KEY=change-this-to-a-separate-long-random-backup-key
BACKUP_REQUIRE_ENCRYPTION=true
# Set true only after S3 versioning, replication, or independent media backup has been tested.
BACKUP_S3_MEDIA_PROTECTED=false
BACKUP_ALERT_WEBHOOK_URL=
BACKUP_ALERT_WEBHOOK_TOKEN=
