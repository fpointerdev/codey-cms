enum PaymentProvider {
  STRIPE
  PAYPAL
  MANUAL
}

enum PaymentProviderMode {
  SANDBOX
  LIVE
}

enum PaymentStatus {
  REQUIRES_ACTION
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentRefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PaymentRefundReason {
  CUSTOMER_REQUEST
  DUPLICATE
  FRAUDULENT
  OTHER
}

model Payment {
  id                  String          @id @default(cuid())
  provider            PaymentProvider @default(STRIPE)
  status              PaymentStatus   @default(PENDING)
  orderId             String?
  amountCents         Int
  currency            String          @default("USD")
  providerReference   String?
  idempotencyKey      String?         @unique
  metadata            Json?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  refunds             PaymentRefund[]

  @@index([orderId])
  @@index([providerReference])
  @@index([provider, status])
}

model PaymentRefund {
  id                  String              @id @default(cuid())
  paymentId           String
  payment             Payment             @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  provider            PaymentProvider
  status              PaymentRefundStatus @default(PENDING)
  amountCents         Int
  currency            String
  reason              PaymentRefundReason @default(CUSTOMER_REQUEST)
  note                String?
  idempotencyKey      String              @unique
  providerReference   String?
  failureMessage      String?
  initiatedByUserId   String?
  supportCaseId       String?             @unique
  supportCase         OrderSupportCase?   @relation(fields: [supportCaseId], references: [id], onDelete: SetNull)
  completedAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([provider, providerReference])
  @@index([paymentId, createdAt])
  @@index([status, updatedAt])
}

model PaymentWebhook {
  id                String          @id @default(cuid())
  provider          PaymentProvider
  eventType         String
  providerEventId   String?         @unique
  providerReference String?
  payload           Json
  processedAt       DateTime?
  createdAt         DateTime        @default(now())

  @@index([provider, eventType])
  @@index([providerReference])
}

model PaymentProviderConfig {
  id                    String              @id @default(cuid())
  siteId                String
  provider              PaymentProvider
  mode                  PaymentProviderMode @default(SANDBOX)
  enabled               Boolean             @default(false)
  publishableKey        String?
  clientId              String?
  webhookId             String?
  encryptedCredentials  String?
  instructions          String?
  lastTestedAt          DateTime?
  lastTestSucceeded     Boolean?
  lastTestMessage       String?
  lastWebhookAt         DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([siteId, provider])
  @@index([siteId, enabled])
  @@index([provider, enabled])
}
